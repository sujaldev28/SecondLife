# ==============================================================================
# SecondLife Platform - Production Environment Template
# Deploy: Vercel (apps/web) + Render (apps/api + services/ai-analyzer)
# ==============================================================================

# Backend API (Render: secondlife-api)
NODE_ENV=production
APP_ENV=production
APP_URL=https://secondlife.vercel.app
API_URL=https://secondlife-api.onrender.com
AI_SERVICE_URL=https://secondlife-ai-analyzer.onrender.com
CORS_ORIGINS=https://secondlife.vercel.app
TRUST_PROXY=true

# Managed PostgreSQL (Production database)
DATABASE_URL=postgresql://user:password@prod-db-host:5432/secondlife_prod
DATABASE_SSL=true

# Security & Cross-Site Cookies (Vercel -> Render over HTTPS)
JWT_ACCESS_SECRET=replace-with-unique-64-char-production-access-secret
JWT_REFRESH_SECRET=replace-with-unique-64-char-production-refresh-secret
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
BCRYPT_ROUNDS=12
INTERNAL_SERVICE_TOKEN=replace-with-unique-shared-production-internal-token

# Demo Mode MUST remain disabled in production (enforced in code when APP_ENV=production)
DEMO_MODE_ENABLED=false

# Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://secondlife-api.onrender.com/api/v1/auth/google/callback

# Frontend Public Variables (Vercel: apps/web)
# NEVER put private secrets in NEXT_PUBLIC_* variables
NEXT_PUBLIC_API_URL=https://secondlife-api.onrender.com/api/v1
NEXT_PUBLIC_APP_NAME=SecondLife
