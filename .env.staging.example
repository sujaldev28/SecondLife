# ==============================================================================
# SecondLife Platform - Staging / Demo Environment Template
# Deploy: Vercel (apps/web) + Render (apps/api + services/ai-analyzer)
# ==============================================================================

# Backend API (Render: secondlife-api)
NODE_ENV=production
APP_ENV=staging
APP_URL=https://staging.secondlife.example.vercel.app
API_URL=https://secondlife-api-staging.onrender.com
AI_SERVICE_URL=https://secondlife-ai-staging.onrender.com
CORS_ORIGINS=https://staging.secondlife.example.vercel.app
TRUST_PROXY=true

# Managed PostgreSQL (Staging database - NEVER point to production DB)
DATABASE_URL=postgresql://user:password@staging-db-host:5432/secondlife_staging
DATABASE_SSL=true

# Security & Cross-Site Cookies (Vercel -> Render over HTTPS)
JWT_ACCESS_SECRET=replace-with-32-plus-char-staging-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-char-staging-refresh-secret
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
BCRYPT_ROUNDS=12
INTERNAL_SERVICE_TOKEN=replace-with-shared-staging-internal-token

# Demo Mode (Allowed in staging/demo only; platform_admin is never exposed when NODE_ENV=production)
DEMO_MODE_ENABLED=true

# Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://secondlife-api-staging.onrender.com/api/v1/auth/google/callback

# Frontend Public Variables (Vercel: apps/web)
NEXT_PUBLIC_API_URL=https://secondlife-api-staging.onrender.com/api/v1
NEXT_PUBLIC_APP_NAME=SecondLife (Staging)
