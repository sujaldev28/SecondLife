# ==============================================================================
# SecondLife Platform - Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000

# API Server
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Database (PostgreSQL in production; PGlite local directory if pglite:// prefix is used)
# Production example: postgresql://secondlife:change_me@localhost:5432/secondlife
DATABASE_URL=pglite://./.data/pglite
DATABASE_SSL=false

# Redis (optional in single-node dev; required for multi-worker production queues/rate-limiting)
REDIS_URL=

# Authentication & Security
# Generate strong 32+ char random secrets for production
JWT_ACCESS_SECRET=change-this-dev-access-secret-to-32-plus-chars
JWT_REFRESH_SECRET=change-this-dev-refresh-secret-to-32-plus-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
INTERNAL_SERVICE_TOKEN=change-this-internal-ai-service-token

# Demo Mode (Enabled in local dev/staging only; disabled in production by default)
DEMO_MODE_ENABLED=true

# Google OAuth 2.0 / OpenID Connect
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Object Storage (Local filesystem in dev; S3-compatible in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Source Control Provider Integrations (Optional until configured)
GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_TOKEN=
BITBUCKET_TOKEN=

# Payment Integration (India-first: Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Delivery (SMTP or console logger in development)
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@secondlife.local

# AI / LLM Provider (Optional enhancement; deterministic + ML pipeline runs without LLM key)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MAX_ARCHIVE_BYTES=52428800
AI_ANALYSIS_TIMEOUT_SECONDS=45

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=SecondLife
NEXT_PUBLIC_RAZORPAY_KEY_ID=
